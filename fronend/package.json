{
  "name": "kladka-workspace",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "setup": "npm ci --prefix backend && npm ci --prefix Kladka.UA",
    "start": "npm start --prefix Kladka.UA",
    "backend": "npm start --prefix backend",
    "web": "npm run web --prefix Kladka.UA",
    "tunnel": "npm run tunnel --prefix Kladka.UA",
