{
  "expo": {
    "name": "Kladka.UA",
    "slug": "kladkaua",
    "version": "1.2.0",
    "scheme": "onlyconstructions",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#10120F",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.onlyconstructions.app",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.onlyconstructions.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#10120F"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Kladka.UA",
      "shortName": "Kladka.UA",
      "themeColor": "#10120F",
      "backgroundColor": "#10120F",
      "output": "single"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Дозвольте додати фото робіт або об’єкта до оголошення чи повідомлення.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#10120F",
          "image": "./assets/icon.png",
          "imageWidth": 110
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0ac91010-c426-4432-a869-f42659c7a12e"
      }
    }
  }
}
