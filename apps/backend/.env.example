# Copy to backend/.env. Do not commit .env.
MONGODB_URI=
PORT=3000
NODE_ENV=development
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
PUBLIC_API_URL=http://localhost:3000
APP_ORIGINS=http://localhost:8081
OAUTH_REDIRECTS=http://localhost:8081/auth/callback,onlyconstructions://auth/callback
# console ONLY on your own laptop; use resend on Render.
MAIL_MODE=console
RESEND_API_KEY=
MAIL_FROM=
TERMS_URL=
TERMS_VERSION=2026-11-15
MODERATION_MODE=manual
MEDIA_USER_LIMIT_MB=20
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Copy a supported version from your Meta app dashboard, e.g. vNN.N
FACEBOOK_GRAPH_VERSION=
